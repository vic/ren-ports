# Terranix: GitHub repository settings as code, applied with OpenTofu. A separate workspace
# and state from DNS and UniFi (./terranix.nix, ./unifi.nix).
#
# The repos whose CI pushes to the attic `ci` cache get the ATTIC_TOKEN Actions secret and the
# ATTIC_PUBLIC_KEY Actions variable. The secret's value is the agenix `attic-ci-push-token`,
# decrypted at apply time, so it exists only in agenix and in this workspace's encrypted state.
# Credential: the operator's own `gh` login (`gh auth token`), so no GitHub credential is stored.
#   github-plan / github-apply (devshell)
{ ren, inputs, ... }:
let
  mkTerranix = import ./_tf.nix { inherit inputs; };
  workdir = "infra/github";
  owner = "sini";
  repos = [
    "xmsg"
    "matrix-xmsg"
    "genie-agent"
  ];
  atticTokenFile = ".secrets/env/prod/attic/ci-push-token.age";
  atticPublicKey = "ci:1i+3fr0BNdABCWGG0CGUpcvzWCLpnx7/EuEQujmowmg=";
in
{
  # The workspace's state passphrase, declared like unifi-state-passphrase.
  ren.aspects.github-state-passphrase-age-secrets = {
    # no `at`: as sini, only uplink includes it (secret lands on uplink nixos)
    age-secrets =
      { environment, ... }:
      {
        age.secrets.github-state-passphrase = {
          rekeyFile = environment.secretPath + "/github-state-passphrase.age";
          intermediary = true;
          generator.script = "rfc3986-secret";
        };
      };
  };

  ren.aspects.flake-terranix-github = {
    at = ren.kinds.system;
    packages =
      { system, ... }:
      let
        pkgs = system.legacyPackages;
        github = pkgs.terraform-providers.integrations_github;
        tf = mkTerranix {
          inherit pkgs workdir;
          name = "github";
          tofu = pkgs.opentofu.withPlugins (_: [ github ]);
          modules = [ (import ./_github-module.nix { inherit (pkgs) lib; inherit github owner repos atticPublicKey; }) ];
        };
        inherit (tf) scripts;
        secretsPrelude = ''
          cd "$(git rev-parse --show-toplevel)"
          # Generated by `tofu init` from the nix-provided providers; never carried over.
          rm -f ${workdir}/.terraform.lock.hcl
          identity=$(mktemp)
          trap 'rm -f "$identity"' EXIT
          age-plugin-yubikey -i > "$identity"
          [[ -s $identity ]] || { echo "no YubiKey identity found; plug in the YubiKey" >&2; exit 1; }
          GITHUB_TOKEN=$(gh auth token) || { echo "not logged in to gh; run \`gh auth login\`" >&2; exit 1; }
          TF_VAR_attic_ci_push_token=$(age -d -i "$identity" ${atticTokenFile})
          TF_VAR_state_passphrase=$(age -d -i "$identity" .secrets/env/prod/github-state-passphrase.age)
          export GITHUB_TOKEN TF_VAR_attic_ci_push_token TF_VAR_state_passphrase
        '';
        mkGithubCommand =
          name: description: text:
          pkgs.writeShellApplication {
            inherit name;
            meta.description = description;
            runtimeInputs = [
              pkgs.age
              pkgs.age-plugin-yubikey
              pkgs.gh
              pkgs.git
            ];
            text = secretsPrelude + text;
          };
      in
      {
        github = tf.app;
        github-plan = mkGithubCommand "github-plan" "OpenTofu plan for the GitHub repository settings" ''
          ${pkgs.lib.getExe scripts.plan}
        '';
        github-apply =
          mkGithubCommand "github-apply" "OpenTofu apply for the GitHub repository settings (asks to confirm)"
            ''
              ${pkgs.lib.getExe scripts.apply}
            '';
      };
    devshell =
      { system, ... }:
      {
        commands = map (name: {
          inherit name;
          help = inputs.self.packages.${system.name}.${name}.meta.description;
          command = ''exec nix run "$(git rev-parse --show-toplevel)#${name}" -- "$@"'';
        }) [ "github-plan" "github-apply" ];
      };
  };
}
