# Public DNS records for every managed zone, as a terranix module (infra/dns/README.md),
# instantiated at the edge environment (the one with dns.publicIPv4).
# Zones are the domains with dns.cloudflare (dns-zones). Records are the domains' own
# (dns-records), plus an A record to the serving environment's public address for each
# served-domains name; served-domains `public.proxied` sets the cloud. Each record lands
# in the longest zone that contains it. Records already in a zone are adopted through
# infra/dns/imports.tf.json (dns-adopt), never duplicated.
{ ren, ... }:
let
  inherit (ren.lib) and when;
in
{
  ren.aspects.dns-records-terranix = {
    at = and [
      ren.kinds.environment
      (when ({ environment, ... }: environment.dns.publicIPv4 != null))
    ];
    terranix =
      {
        environment,
        lib,
        dns-zones ? [ ],
        dns-records ? [ ],
        served-domains ? [ ],
        ...
      }:
      let
        inherit (ren.helpers) recordKey;
        # A record routes to the longest managed zone containing it, from any
        # environment; a sub-zone without its own zone is hosted in its parent.
        zones = map (z: z.zone) dns-zones;
        zoneOf = ren.helpers.longestSuffix zones;
        edge = environment.dns.publicIPv4;

        declared = map (
          r:
          {
            proxied = false;
            priority = null;
            ttl = 1;
            comment = null;
          }
          // r
          // {
            content = if r.content or null == null then edge else r.content;
          }
        ) dns-records;
        declaredNames = map (r: r.name) declared;

        # A served name gets an A record to its environment's public address,
        # unless the zone declares that name itself (hs, jellyfin: CNAMEs).
        served = lib.concatMap (
          s:
          map (name: {
            inherit name;
            type = "A";
            content = s.public.address;
            inherit (s.public) proxied;
            priority = null;
            ttl = 1;
            comment = null;
          }) (builtins.filter (n: !builtins.elem n declaredNames) s.domains)
        ) (builtins.filter (s: s.public or null != null) served-domains);

        records = lib.listToAttrs (
          map (r: lib.nameValuePair (recordKey r) (r // { zone = zoneOf r.name; })) (
            builtins.filter (r: zoneOf r.name != null) (declared ++ served)
          )
        );
        accounts = lib.unique (map (z: z.account) dns-zones);
      in
      assert lib.assertMsg (
        builtins.length accounts == 1
      ) "dns: one Cloudflare account per workspace (got: ${toString accounts})";
      import ./_dns-module.nix { inherit lib zones records accounts environment; };
  };

  # The OpenTofu state passphrase (TF_VAR_state_passphrase). Generated by
  # `agenix generate` onto the master identities; intermediary, so it is never
  # rekeyed to or decrypted on the host that declares it (uplink, the prod edge).
  ren.aspects.dns-state-passphrase-age-secrets.age-secrets =
    { environment, ... }:
    {
      age.secrets.tofu-state-passphrase = {
        rekeyFile = environment.secretPath + "/tofu-state-passphrase.age";
        intermediary = true;
        generator.script = "rfc3986-secret";
      };
    };
}
