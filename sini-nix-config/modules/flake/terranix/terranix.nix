# Terranix: Cloudflare DNS as code, applied with OpenTofu (infra/dns/README.md).
# One workspace and one state for every managed zone. The edge environment (the one with
# dns.publicIPv4) instantiates its `terranix` class (records module, ./dns.nix) into
# terranixModules.dns. dns-plan / dns-apply / dns-adopt packages and devshell commands.
#   nix build .#dns.config   -- config.tf.json
{ ren, lib, inputs, ... }:
let
  mkTerranix = import ./_tf.nix { inherit inputs; };
  workdir = "infra/dns";
  # The API token for each Cloudflare account a domain names in dns.cloudflare.
  cloudflareTokens.json64 = ".secrets/env/prod/cloudflare-api-key.age";
in
{
  ren.aspects.flake-terranix = {
    at = ren.kinds.fleet;
    flake-inputs = { ... }: {
      terranix = {
        url = "github:terranix/terranix";
        inputs = {
          nixpkgs.follows = "nixpkgs-unstable";
          flake-parts.follows = "flake-parts";
          import-tree.follows = "import-tree";
          systems.follows = "systems";
        };
      };
    };
    # The terranix flakeModule perSystem part is _tf.nix; the class (ren.classes.terranix, terranixConfigurations.dns-<env>) is platforms/terranix.nix.
  };

  ren.aspects.flake-terranix-dns = {
    at = ren.kinds.system;
    packages =
      { system, ... }:
      let
        pkgs = system.legacyPackages;
        # Providers come from nixpkgs, so `tofu init` never downloads one and required_providers takes the version from the package.
        cloudflare = pkgs.terraform-providers.cloudflare_cloudflare;
        # The edge environment's class output (platforms/terranix.nix), the one with dns.publicIPv4.
        edge = lib.head (lib.attrNames (lib.filterAttrs (_: e: e.dns.publicIPv4 != null) ren.environment));
        base = inputs.self.terranixConfigurations."dns-${edge}";
        tf = mkTerranix {
          inherit pkgs workdir;
          name = "dns";
          tofu = pkgs.opentofu.withPlugins (_: [ cloudflare ]);
          configuration =
            ((pkgs.formats.json { }).generate "config.tf.json" (
              lib.recursiveUpdate base.config { terraform.required_providers.cloudflare.version = cloudflare.version; }
            )).overrideAttrs
              { passthru = { inherit (base) config _meta; }; };
        };
        inherit (tf) scripts terraformConfiguration;
        inherit (terraformConfiguration) _meta;
        tofu = pkgs.lib.getExe tf.terraformWrapper;
        # Declared records as [{ address, name, type, content, zone }] for dns-adopt.
        declared = pkgs.writeText "dns-declared.json" (builtins.toJSON _meta.records);

        # Decrypts the Cloudflare token and the state passphrase into this process's
        # env only. Run from the repo root (the terranix scripts cd into ${workdir}).
        secretsPrelude = ''
          cd "$(git rev-parse --show-toplevel)"
          # Generated by `tofu init` from the nix-provided providers; never carried over.
          rm -f ${workdir}/.terraform.lock.hcl
          identity=$(mktemp)
          trap 'rm -f "$identity"' EXIT
          age-plugin-yubikey -i > "$identity"
          [[ -s $identity ]] || { echo "no YubiKey identity found; plug in the YubiKey" >&2; exit 1; }
          CLOUDFLARE_API_TOKEN=$(age -d -i "$identity" ${cloudflareTokens.${_meta.account}})
          TF_VAR_state_passphrase=$(age -d -i "$identity" .secrets/env/${_meta.environment}/tofu-state-passphrase.age)
          export CLOUDFLARE_API_TOKEN TF_VAR_state_passphrase
        '';

        mkDnsCommand =
          name: description: runtimeInputs: text:
          pkgs.writeShellApplication {
            inherit name;
            meta.description = description;
            runtimeInputs = [
              pkgs.age
              pkgs.age-plugin-yubikey
              pkgs.git
            ]
            ++ runtimeInputs;
            text = secretsPrelude + text;
          };
      in
      {
        dns = tf.app;
        dns-plan = mkDnsCommand "dns-plan" "OpenTofu plan for the Cloudflare DNS records" [ ] ''
          ${pkgs.lib.getExe scripts.plan}
        '';
        dns-apply =
          mkDnsCommand "dns-apply" "OpenTofu apply for the Cloudflare DNS records (asks to confirm)" [ ]
            ''
              ${pkgs.lib.getExe scripts.apply}
            '';
        dns-adopt =
          mkDnsCommand "dns-adopt" "Write ${workdir}/imports.tf.json for records that already exist"
            [
              pkgs.curl
              pkgs.jq
            ]
            (import ./_dns-adopt.nix { inherit workdir declared tofu scripts; exe = pkgs.lib.getExe; });
      };
    # Each devshell command re-evaluates the working tree on every call, so an edit is planned without reloading the devshell.
    devshell =
      { system, ... }:
      {
        commands = map (name: {
          inherit name;
          help = inputs.self.packages.${system.name}.${name}.meta.description;
          command = ''exec nix run "$(git rev-parse --show-toplevel)#${name}" -- "$@"'';
        }) [ "dns-adopt" "dns-plan" "dns-apply" ];
      };
  };
}
