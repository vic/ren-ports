  content:
  - type: text
    text: Configure options in `.clang-format` file.
    styles: {}
  children: []
- id: 6adf9f28-a304-4106-93b3-78bd6ed28103
  type: codeBlock
  props:
    language: text
  content:
  - type: text
    text: |
      # General configuration for all languages.

      ---
      Language: Cpp
      BasedOnStyle: LLVM
      IndentWidth: 4
      TabWidth: 4
      UseTab: Always
    styles: {}
  children: []
- id: 9312743a-b879-42c4-8352-c2af6dd8362f
  type: run
  props:
    type: bash
    name: Format with clang-format
    code: clang-format -i {include,src}/**/*.{cc,hh}
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
