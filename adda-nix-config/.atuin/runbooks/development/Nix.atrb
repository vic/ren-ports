    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
- id: 57316a10-6cf0-43a0-a27c-70affc8db784
  type: run
  props:
    type: bash
    name: Inspect the flake metadata, can grep on desired inputs names
    code: nix flake metadata
    pty: ''
    global: false
    outputVisible: true
    dependency: '{}'
    terminalRows: 20
  children: []
