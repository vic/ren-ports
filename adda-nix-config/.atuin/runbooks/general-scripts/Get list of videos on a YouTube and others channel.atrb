- id: 010e5363-aafc-43b7-8869-e53a287283b4
  type: run
  props:
    type: bash
    name: Terminal 1
    code: yt-dlp --skip-download --flat-playlist --print "%(title)s %(webpage_url)s" "{{ var.channel_url }}"
