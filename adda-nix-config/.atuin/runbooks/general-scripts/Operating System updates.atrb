  type: dropdown
  props:
    name: rebuildMode
    options: Enable new OS on next boot:boot, Switch to new OS immediately:switch
    fixedOptions: Enable new OS on next boot:boot, Switch to new OS immediately:switch
    variableOptions: ''
    commandOptions: ''
    value: switch
    optionsType: fixed
    interpreter: bash
    delimiter: ':'
  children: []
