+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PIPED: &str = "{ xs = [ 1 2 ] |> map (x: x + 1) ; y = builtins.length <| [ 1 ]; }\n";
+
+    #[test]
+    fn sources_without_pipes_are_not_masked() {
+        assert!(mask_pipe_operators("{ a = { x = 1; } // { y = 2; }; }").is_none());
+    }
+
+    #[test]
+    fn pipelines_parse_and_keep_the_original_offsets() {
+        let tree = parse_valid(PIPED, "test").expect("pipelines parse");
+        let mut found = Vec::new();
+        let mut stack = vec![tree.root_node()];
+        while let Some(node) = stack.pop() {
+            if node.kind() == "list_expression" {
+                found.push(text(node, PIPED).to_string());
+            }
+            let mut cursor = node.walk();
+            stack.extend(node.children(&mut cursor));
+        }
+        found.sort();
+        assert_eq!(found, vec!["[ 1 2 ]".to_string(), "[ 1 ]".to_string()]);
+    }
+}
