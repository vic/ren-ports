+#[test]
+fn pipe_operators_are_sorted_and_preserved() {
+    if !have("nixfmt") {
+        eprintln!("skipping: nixfmt not on PATH");
+        return;
+    }
+    let src =
+        "{\n  b = { y = 2; x = 1; } |> builtins.attrNames;\n  a = builtins.length <| [ 1 2 ];\n}\n";
+    let cfg = Config::default();
+    let once = process(src, &cfg).unwrap();
+    assert_eq!(fingerprint(src).unwrap(), fingerprint(&once).unwrap());
+    assert!(once.contains("|>") && once.contains("<|"), "{once}");
+    let a = once.find("a =").expect("a binding");
+    let b = once.find("b =").expect("b binding");
+    assert!(
+        a < b,
+        "top-level attrs stay sorted around pipelines: {once}"
+    );
+    assert_eq!(
+        once,
+        process(&once, &cfg).unwrap(),
+        "not idempotent: {once}"
+    );
+}
