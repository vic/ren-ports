 use anyhow::{Result, anyhow, bail};
 use tree_sitter::{Node, Parser};
 
+/// RFC 148 pipe operators. tree-sitter-nix does not know them, so every file
+/// using one parses with ERROR nodes and pedantix refuses to touch it.
+const PIPE_OPERATORS: [&[u8; 2]; 2] = [b"|>", b"<|"];
+
+/// Stand-in the grammar does know: `->` is a binary operator of the same two-byte
+/// width and of the lowest precedence in the grammar, so the masked tree has the
+/// same node extents and (bar associativity, which nothing here inspects) the same
+/// shape as the pipeline it stands for.
+const PIPE_MASK: &[u8; 2] = b"->";
+
+/// Rewrite every pipe operator to `PIPE_MASK`, or `None` when the source has none.
+///
+/// Byte-for-byte length preserving, so node offsets of the masked parse index the
+/// *original* source — which is what every pass splices its output from, and what
+/// `semantic::canon` reads token text from, so pipes stay distinguishable there.
+/// `|` and `<` followed by `|` cannot occur in Nix outside a pipe operator except
+/// inside strings and comments, where masking changes no token boundary.
+fn mask_pipe_operators(src: &str) -> Option<String> {
+    let mut masked = src.as_bytes().to_vec();
+    let mut found = false;
+    let mut i = 0;
+    while i + 1 < masked.len() {
+        if PIPE_OPERATORS.contains(&&[masked[i], masked[i + 1]]) {
+            masked[i..i + 2].copy_from_slice(PIPE_MASK);
+            found = true;
+            i += 2;
+        } else {
+            i += 1;
+        }
+    }
+    found.then(|| String::from_utf8(masked).expect("masking keeps the input valid UTF-8"))
+}
+
 pub fn parse(src: &str) -> Result<tree_sitter::Tree> {
+    let masked = mask_pipe_operators(src);
     let mut parser = Parser::new();
     parser
         .set_language(&tree_sitter_nix::LANGUAGE.into())
         .expect("tree-sitter-nix language is compatible");
     parser
-        .parse(src, None)
+        .parse(masked.as_deref().unwrap_or(src), None)
         .ok_or_else(|| anyhow!("tree-sitter failed to parse input"))
 }
 
