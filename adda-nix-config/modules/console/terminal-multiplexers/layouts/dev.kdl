layout {
  // Templates.

  tab_template name="ui" {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    children
    pane size=2 borderless=true {
        plugin location="status-bar"
    }
  }

  default_tab_template {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="vertical" {
      pane
      // pane stacked=true { children; }
    }
    pane size=2 borderless=true {
        plugin location="status-bar"
    }
  }

  swap_tiled_layout min_panes=3 name="stacked" {
    ui {
      pane split_direction="vertical" {
        pane
        pane stacked=true { children; }
      }
    }
  }

  swap_tiled_layout name="vertical" {
      ui max_panes=5 {
          pane split_direction="vertical" {
              pane
              pane { children; }
          }
      }
      ui max_panes=8 {
          pane split_direction="vertical" {
              pane { children; }
              pane { pane; pane; pane; pane; }
          }
      }
      ui max_panes=12 {
          pane split_direction="vertical" {
              pane { children; }
              pane { pane; pane; pane; pane; }
              pane { pane; pane; pane; pane; }
          }
      }
  }

  swap_tiled_layout name="horizontal" {
      ui max_panes=4 {
          pane
          pane
      }
      ui max_panes=8 {
          pane {
              pane split_direction="vertical" { children; }
              pane split_direction="vertical" { pane; pane; pane; pane; }
          }
      }
      ui max_panes=12 {
          pane {
              pane split_direction="vertical" { children; }
              pane split_direction="vertical" { pane; pane; pane; pane; }
              pane split_direction="vertical" { pane; pane; pane; pane; }
          }
      }
  }

  // swap_floating_layout name="staggered" {
  //     floating_panes {
  //         pane height="97%" width="97%" x=2 y=2
  //     }
  //     floating_panes max_panes=2 {
  //         pane height="97%" x="2%" width="48%"
  //         pane height="97%" x="52%" width="48%"
  //     }
  // }

  swap_floating_layout name="enlarged" {
      floating_panes {
          pane { x "1%"; y 4; width "99%"; height "97%"; }
          pane { x "1%"; y 5; width "99%"; height "94%"; }
          pane { x "1%"; y 6; width "99%"; height "91%"; }
          pane { x "1%"; y 7; width "99%"; height "88%"; }
          pane { x "1%"; y 8; width "99%"; height "85%"; }
          pane { x "1%"; y 9; width "99%"; height "83%"; }
          pane { x "1%"; y 10; width "99%"; height "81%"; }
          pane { x "1%"; y 11; width "99%"; height "78%"; }
      }
  }

  // swap_floating_layout name="spread" {
  //     floating_panes exact_panes=1 {
  //         pane {y "50%"; x "50%"; }
  //     }
  //     floating_panes exact_panes=2 {
  //         pane { x "1%"; y "25%"; width "45%"; }
  //         pane { x "50%"; y "25%"; width "45%"; }
  //     }
  //     floating_panes exact_panes=3 {
  //         pane { y "55%"; width "45%"; height "45%"; }
  //         pane { x "1%"; y "1%"; width "45%"; }
  //         pane { x "50%"; y "1%"; width "45%"; }
  //     }
  //     floating_panes exact_panes=4 {
  //         pane { x "1%"; y "55%"; width "45%"; height "45%"; }
  //         pane { x "50%"; y "55%"; width "45%"; height "45%"; }
  //         pane { x "1%"; y "1%"; width "45%"; height "45%"; }
  //         pane { x "50%"; y "1%"; width "45%"; height "45%"; }
  //     }
  // }
}
